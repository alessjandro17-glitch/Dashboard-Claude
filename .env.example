# Conexión a PostgreSQL. Para Supabase: Project Settings > Database > Connection string (URI, modo "Session").
DATABASE_URL=postgres://mca:mca_dev@localhost:5432/mca
PORT=3001
ACCOUNT_HANDLE=mundo.curioso13
# Si se define, la aplicación pide contraseña para entrar.
APP_PASSWORD=
SESSION_SECRET=

# AI Advisor (Claude). Clave de https://platform.claude.com > API Keys.
ANTHROPIC_API_KEY=

# Instagram (API con inicio de sesión de Instagram).
# Opción A (la más sencilla): genera un token en el panel de Meta y pégalo en Configuración > Integraciones. No hace falta nada aquí.
# Opción B (OAuth): ID y clave secreta de la app de Instagram (panel de Meta > Instagram > Configuración de la API) y una URL de redirección HTTPS registrada en la app.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Adónde vuelve el navegador tras el OAuth (en desarrollo, la web de Vite).
APP_URL=http://localhost:5173
# Cada cuántas horas se sincronizan los Reels de los últimos 60 días (0 = desactivado).
INSTAGRAM_SYNC_HOURS=6
# Clave para cifrar el token de Instagram en la base de datos. Si se deja vacía, se genera una en .secrets/integrations.key.
INTEGRATIONS_SECRET=
